# =============================================================
# SENSITIVE FILES — NEVER COMMIT THESE
# =============================================================

# Environment variable files (all variants)
.env
.env.local
.env.development
.env.production
.env.staging
.env.test
.env.*.local
*.env
!*.env.example   # Allow example/template files

# Token & secret files
token.txt
temp_token.txt
*.token
*.secret
*.key
*.pem
*.p12
*.pfx
*.cer
*.crt
*.der

# .NET User Secrets & local config overrides
appsettings.Development.json
appsettings.Local.json
appsettings.Production.json
appsettings.Staging.json
secrets.json
usersecrets.json

# Private key files
id_rsa
id_ed25519
*.ppk

# Credential & config files
.credentials
credentials.json
service-account.json
firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist

# =============================================================
# BUILD ARTIFACTS
# =============================================================

# .NET
bin/
obj/

# Node / Frontend
node_modules/
dist/
dist-ssr/

