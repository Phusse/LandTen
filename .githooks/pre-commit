#!/usr/bin/env bash
# =============================================================
# Pre-Commit Secret Scanner
# Blocks commits that contain sensitive data patterns.
# =============================================================

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

echo "🔍 Scanning staged files for secrets..."

ERRORS=0

# -----------------------------------------------------------
# 1. BLOCK SENSITIVE FILE EXTENSIONS / NAMES
# -----------------------------------------------------------
BLOCKED_FILES=(
  "\.env$"
  "\.env\..*"
  "token\.txt$"
  "temp_token\.txt$"
  "secrets\.json$"
  "credentials\.json$"
  "service-account\.json$"
  "appsettings\.Development\.json$"
  "appsettings\.Production\.json$"
  "appsettings\.Local\.json$"
  "appsettings\.Staging\.json$"
  "\.pem$"
  "\.p12$"
  "\.pfx$"
  "\.key$"
  "id_rsa$"
  "id_ed25519$"
  "firebase-adminsdk.*\.json$"
  "google-services\.json$"
)

for pattern in "${BLOCKED_FILES[@]}"; do
  MATCHES=$(git diff --cached --name-only | grep -E "$pattern")
  if [ -n "$MATCHES" ]; then
    echo -e "${RED}❌ BLOCKED FILE: Sensitive file staged for commit:${NC}"
    echo -e "${RED}   $MATCHES${NC}"
    ERRORS=$((ERRORS + 1))
  fi
done

# -----------------------------------------------------------
# 2. SCAN FILE CONTENTS FOR SECRET PATTERNS
# -----------------------------------------------------------
SECRET_PATTERNS=(
  # Connection strings
  "Host=.*;Password="
  "Server=.*;Password="
  "Data Source=.*;Password="

  # Generic secrets
  "password\s*=\s*['\"][^'\"]{4,}"
  "passwd\s*=\s*['\"][^'\"]{4,}"
  "secret\s*=\s*['\"][^'\"]{8,}"
  "api[_-]?key\s*=\s*['\"][^'\"]{8,}"
  "api[_-]?secret\s*=\s*['\"][^'\"]{8,}"

  # JWT secrets
  "SecretKey\s*=\s*['\"][^'\"]{8,}"
  "JWT_SECRET"

  # Cloud provider keys
  "AKIA[0-9A-Z]{16}"
  "sk_live_[0-9a-zA-Z]{24}"
  "sk_test_[0-9a-zA-Z]{24}"

  # Supabase / DB URLs with credentials
  "postgres://[^:]+:[^@]+@"
  "Password=[^;]{4,};"

  # Cloudinary
  "cloudinary://[0-9]+:[^@]+@"
  "CLOUDINARY_API_SECRET"

  # Paystack / Flutterwave
  "sk_[a-z]+_[a-zA-Z0-9]{20,}"
  "FLUTTERWAVE_SECRET_KEY\s*=\s*['\"][^'\"_]"
  "PAYSTACK_SECRET_KEY\s*=\s*['\"][^'\"_]"

  # Private keys
  "BEGIN RSA PRIVATE KEY"
  "BEGIN EC PRIVATE KEY"
  "BEGIN OPENSSH PRIVATE KEY"
  "BEGIN PGP PRIVATE KEY"
)

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -v "\.env\.example$" | grep -v "example\." | grep -v "\.example$" | grep -v "^\.githooks/")

if [ -n "$STAGED_FILES" ]; then
  for file in $STAGED_FILES; do
    for pattern in "${SECRET_PATTERNS[@]}"; do
      MATCH=$(git diff --cached -U0 -- "$file" | grep "^+" | grep -v "^+++" | grep -iE "$pattern" 2>/dev/null)
      if [ -n "$MATCH" ]; then
        echo -e "${RED}❌ POSSIBLE SECRET DETECTED in $file:${NC}"
        echo -e "${YELLOW}   Pattern: $pattern${NC}"
        echo -e "${YELLOW}   Match:   $(echo "$MATCH" | head -3)${NC}"
        ERRORS=$((ERRORS + 1))
      fi
    done
  done
fi

# -----------------------------------------------------------
# 3. RESULT
# -----------------------------------------------------------
if [ $ERRORS -gt 0 ]; then
  echo ""
  echo -e "${RED}╔══════════════════════════════════════════════════════╗${NC}"
  echo -e "${RED}║  🚨 COMMIT BLOCKED — $ERRORS secret(s) detected!       ║${NC}"
  echo -e "${RED}║                                                      ║${NC}"
  echo -e "${RED}║  Remove the sensitive data, then try again.          ║${NC}"
  echo -e "${RED}║  To skip (DANGEROUS): git commit --no-verify         ║${NC}"
  echo -e "${RED}╚══════════════════════════════════════════════════════╝${NC}"
  exit 1
else
  echo -e "${GREEN}✅ No secrets detected. Proceeding with commit.${NC}"
  exit 0
fi
