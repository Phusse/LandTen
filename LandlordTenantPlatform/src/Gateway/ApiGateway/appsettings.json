{
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "SecretKey": "",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "ReverseProxy": {
    "Routes": {
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "property-route": {
        "ClusterId": "property-cluster",
        "Match": {
          "Path": "/api/properties/{**catch-all}"
        }
      },
      "application-route": {
        "ClusterId": "application-cluster",
        "Match": {
          "Path": "/api/applications/{**catch-all}"
        }
      },
      "messaging-route": {
        "ClusterId": "messaging-cluster",
        "Match": {
          "Path": "/api/messages/{**catch-all}"
        }
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://userservice-api:8080/"
          }
        }
      },
      "property-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://propertyservice-api:8080/"
          }
        }
      },
      "application-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://applicationservice-api:8080/"
          }
        }
      },
      "messaging-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://messagingservice-api:8080/"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://paymentservice-api:8080/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*"
}