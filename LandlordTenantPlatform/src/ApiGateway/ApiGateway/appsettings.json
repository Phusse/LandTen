{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "SuperSecretKeyForDevelopmentOnlyPleaseChangeLater",
    "Issuer": "",
    "Audience": "",
    "AccessTokenExpiryMinutes": 15
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "userservice-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "RateLimiterPolicy": "AuthPolicy"
      },
      "users-route": {
        "ClusterId": "userservice-cluster",
        "Match": {
          "Path": "/users/{**catch-all}"
        }
      },
      "kyc-route": {
        "ClusterId": "userservice-cluster",
        "Match": {
          "Path": "/kyc/{**catch-all}"
        }
      },
      "admin-route": {
        "ClusterId": "userservice-cluster",
        "Match": {
          "Path": "/admin/{**catch-all}"
        }
      },
      "admin-properties-route": {
        "ClusterId": "propertyservice-cluster",
        "Order": -1,
        "Match": {
          "Path": "/admin/properties/{**catch-all}"
        }
      },
      "properties-route": {
        "ClusterId": "propertyservice-cluster",
        "Match": {
          "Path": "/properties/{**catch-all}"
        }
      },
      "applications-route": {
        "ClusterId": "applicationservice-cluster",
        "Match": {
          "Path": "/applications/{**catch-all}"
        }
      },
      "conversations-route": {
        "ClusterId": "messagingservice-cluster",
        "Match": {
          "Path": "/conversations/{**catch-all}"
        }
      },
      "wallets-route": {
        "ClusterId": "paymentservice-cluster",
        "Match": {
          "Path": "/wallets/{**catch-all}"
        }
      },
      "payments-route": {
        "ClusterId": "paymentservice-cluster",
        "Match": {
          "Path": "/payments/{**catch-all}"
        }
      },
      "escrow-route": {
        "ClusterId": "paymentservice-cluster",
        "Match": {
          "Path": "/escrow/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "userservice-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://127.0.0.1:5001"
          }
        }
      },
      "propertyservice-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://127.0.0.1:5002"
          }
        }
      },
      "applicationservice-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://127.0.0.1:5003"
          }
        }
      },
      "messagingservice-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://127.0.0.1:5005"
          }
        }
      },
      "paymentservice-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://127.0.0.1:5004"
          }
        }
      }
    }
  }
}